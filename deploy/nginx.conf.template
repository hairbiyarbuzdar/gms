# Nginx site config for Iron Reserve.
#
# Copy to /etc/nginx/sites-available/ironreserve, replace YOUR_DOMAIN and
# APP_PORT, then symlink into sites-enabled. Certbot rewrites this file when
# it issues the certificate, adding the TLS block and the port 80 redirect.
#
#   sudo cp deploy/nginx.conf.template /etc/nginx/sites-available/ironreserve
#   sudo sed -i 's/YOUR_DOMAIN/gms.example.com/g; s/APP_PORT/3000/g' \
#       /etc/nginx/sites-available/ironreserve
#   sudo ln -s /etc/nginx/sites-available/ironreserve /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Certbot writes its challenge files here.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:APP_PORT;
        proxy_http_version 1.1;

        # Auth.js builds callback URLs from these. Without them every OAuth
        # and cookie redirect would point at http://127.0.0.1 instead of the
        # public https origin.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # Next.js dev-style HMR is off in production, but keep upgrade
        # handling so future websocket use does not need a config change.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 60s;
        proxy_cache_bypass $http_upgrade;
    }

    # Immutable build assets - safe to cache hard.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:APP_PORT;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Barcode labels and CSV exports can be large-ish; invoices are not.
    client_max_body_size 10M;

    # Basic hardening. HSTS is added by certbot with the TLS block.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
