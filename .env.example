# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ironreserve?schema=public"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""

# Canonical URL of the app. In production set to the real https origin.
AUTH_URL="http://localhost:3000"

# Seeded superadmin account (used by prisma/seed.ts on first run only).
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
